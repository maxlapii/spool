# Port for the API server (the Vite dev server proxies /api and /assets here)
API_PORT=4100

# The Claude assistant uses your local Claude Code sign-in through the Claude
# Agent SDK — no API key needed. Run `claude` once in a terminal to sign in.
# Optional overrides:
# CLAUDE_MODEL=claude-opus-5-5     # model for the assistant (default: your Claude Code default)
# ANTHROPIC_API_KEY=               # if set, Claude Code bills this key instead of your subscription

# Optional: path to an ffmpeg binary. Defaults to the one bundled by ffmpeg-static.
# FFMPEG_PATH=/usr/local/bin/ffmpeg
